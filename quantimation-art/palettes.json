        "amplitudePx": 0.8,
        "seeds": 3,
        "holdFrames": 3
      },
      "movingHold": {
        "amplitudePx": 0.35,
        "seeds": 3,
        "holdFrames": 3,
        "minHoldFrames": 48
      },
      "never": [
        "speaking close-up",
        "camera move in progress",
        "pupils",
        "backgrounds",
        "props at rest"
      ]
    },
    "screenSpace": {
      "compensate": true,
      "growClamp": [
        0.8,
        1.25
      ],
      "minPx": 1.25
    },
