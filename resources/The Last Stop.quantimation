  "scenes": [
    {
      "id": "arrival",
      "name": "A very normal shift",
      "description": "Wide establishing shot. Nova and Pip arrive at a lonely diner at the edge of the galaxy.",
      "duration": 12,
      "environment": "exterior",
      "background": "#18222e",
      "camera": {
        "zoom": 1,
        "x": 640,
        "y": 360,
        "panX": 15,
        "panY": 0
      },
      "instances": [
        {
          "id": "nova1",
          "assetId": "nova",
          "x": 667,
          "y": 666,
          "scale": 0.86,
          "flip": false,
          "motion": "walk",
          "rotation": 0,
          "keyframes": [
            {
              "t": 0,
              "x": 570
            },
            {
              "t": 5,
              "x": 685
            }
          ]
        },
        {
          "id": "pip1",
          "assetId": "pip",
          "x": 890,
          "y": 666,
          "scale": 0.87,
          "flip": false,
          "motion": "bounce",
          "rotation": 0,
          "keyframes": [
            {
              "t": 0,
              "x": 830
            },
            {
              "t": 5,
              "x": 918
            }
          ]
        }
      ],
      "dialogue": [
        {
          "id": "a1",
          "speaker": "nova",
          "text": "The last diner in the universe. Please tell me they have coffee.",
          "at": 1,
          "duration": 5
        },
        {
          "id": "a2",
          "speaker": "pip",
          "text": "Better. Their toaster can predict the future.",
          "at": 7,
          "duration": 4
        }
      ]
    },
    {
      "id": "order",
      "name": "Breakfast with destiny",
      "description": "Inside the diner. The toaster waits on the counter, glowing with unwarranted confidence.",
      "duration": 13,
      "environment": "diner",
      "background": "#18222e",
      "camera": {
        "zoom": 1,
        "x": 640,
        "y": 360,
        "panX": 0,
        "panY": 0
      },
      "instances": [
        {
          "id": "nova2",
          "assetId": "nova",
          "x": 405,
          "y": 687,
          "scale": 1,
          "flip": false,
          "motion": "idle",
          "rotation": 0,
          "keyframes": []
        },
        {
          "id": "pip2",
          "assetId": "pip",
          "x": 877,
          "y": 686,
          "scale": 1,
          "flip": false,
          "motion": "wave",
          "rotation": 0,
          "keyframes": []
        },
        {
          "id": "toast2",
          "assetId": "toaster",
          "x": 650,
          "y": 487,
          "scale": 0.9,
          "flip": false,
          "motion": "float",
          "rotation": 0,
          "keyframes": []
        }
      ],
      "dialogue": [
        {
          "id": "b1",
          "speaker": "nova",
          "text": "Fine. What does my future look like?",
          "at": 1,
          "duration": 3
        },
        {
          "id": "b2",
          "speaker": "toaster",
          "text": "In approximately thirty seconds, you will be disappointed.",
          "at": 5,
          "duration": 5
        }
      ]
    },
    {
      "id": "reveal",
      "name": "The prophecy",
      "description": "Push in toward the toaster. Pip leans closer as Nova processes the news.",
      "duration": 11,
      "environment": "diner",
      "background": "#18222e",
      "camera": {
        "zoom": 1.25,
        "x": 650,
        "y": 399,
        "panX": -15,
        "panY": 5
      },
      "instances": [
        {
          "id": "nova3",
          "assetId": "nova",
          "x": 385,
          "y": 687,
          "scale": 1,
          "flip": false,
          "motion": "still",
          "rotation": 0,
          "keyframes": []
        },
        {
          "id": "pip3",
          "assetId": "pip",
          "x": 907,
          "y": 686,
          "scale": 1,
          "flip": false,
          "motion": "bounce",
          "rotation": 0,
          "keyframes": [
            {
              "t": 0,
              "x": 907
            },
            {
              "t": 5,
              "x": 835
            }
          ]
        },
        {
          "id": "toast3",
          "assetId": "toaster",
          "x": 650,
          "y": 487,
          "scale": 0.9,
          "flip": false,
          "motion": "bounce",
          "rotation": 0,
          "keyframes": []
        }
      ],
      "dialogue": [
        {
          "id": "c1",
          "speaker": "pip",
          "text": "Incredible. How does it know?",
          "at": 1,
          "duration": 3
        },
        {
          "id": "c2",
          "speaker": "toaster",
          "text": "We are out of coffee.",
          "at": 5,
          "duration": 3
        }
      ]
    },
    {
      "id": "ending",
      "name": "Some things are universal",
      "description": "Back outside. Pip follows Nova into the desert. Hold on the diner for the final beat.",
      "duration": 12,
      "environment": "exterior",
      "background": "#18222e",
      "camera": {
        "zoom": 1,
        "x": 640,
        "y": 360,
        "panX": 0,
        "panY": 0
      },
