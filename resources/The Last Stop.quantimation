      "dialogue": [
        {
          "id": "d1",
          "speaker": "nova",
          "text": "Next time, we are stopping at a gas station.",
          "at": 1,
          "duration": 4
        },
        {
          "id": "d2",
          "speaker": "pip",
          "text": "Their microwave only predicts the past.",
